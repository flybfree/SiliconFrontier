# Runtime working directory — populated at runtime, not authored content
data/*.json

# Simulation saves — runtime output, not source
saves/*.json

# Simulation run logs — runtime output
logs/*.log

# Build/package output
build/
dist/
dist/**
# One-off package retries and release copies are local-only artifacts.
build_*/
dist_*/

# Graphify's reusable graph remains tracked; its transient extraction, cache,
# learning, and dated-run artifacts should stay local.
graphify-out/cache/
graphify-out/memory/
graphify-out/reflections/
graphify-out/[0-9][0-9][0-9][0-9]-*/
graphify-out/.graphify_*
graphify-out/.vocab.txt
graphify-out/cost.json
graphify-out/manifest.json

# Development scenarios — ignored by default; add explicit exceptions below for released scenarios
scenarios/*
!scenarios/default/
!scenarios/cascade_failure/
!scenarios/prisoners_dilemma/

# Python cache
__pycache__/
*.pyc
*.pyo
